# Copy to .env and fill in. .env is never committed.

# Liara API token: console.liara.ir -> API section.
LIARA_API_TOKEN=fake-liara-token
# Liara API (default, see F4).
LIARA_API_URL=https://api.liara.ir
# Optional: work inside a team (its wallet pays). See `starcoach teams`.
LIARA_TEAM_ID=

# Your OpenAI-compatible LLM provider.
LLM_BASE_URL=https://llm.example.com/v1
LLM_MODEL=fake-model
LLM_API_KEY=fake-llm-key
